{
  "name": "dotkernel/dot-response-header",
  "type": "library",
  "description": "Dotkernel middleware for setting custom response headers.",
  "license": "MIT",
  "homepage": "https://github.com/dotkernel/dot-response-header",
  "authors": [
    {
      "name": "Dotkernel Team",
      "email": "team@dotkernel.com"
    }
  ],
  "keywords": [
    "dotkernel",
    "api",
    "headers",
    "middleware",
    "laminas",
    "mezzio"
  ],
  "require": {
    "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0",
    "mezzio/mezzio-router": "^3.16",
    "psr/http-client": "^1.0",
    "psr/http-message": "^1.0 || ^2.0"
  },
  "require-dev": {
    "laminas/laminas-coding-standard": "^3.0",
    "laminas/laminas-diactoros": "^3.1",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^10.2"
  },
  "autoload": {
    "psr-4": {
      "Dot\\ResponseHeader\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DotTest\\ResponseHeader\\": "test/"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test",
      "@static-analysis"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test": "phpunit --colors=always",
    "static-analysis": "phpstan analyse --memory-limit 1G"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  }
}
